{
  "name": "webhooker",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "GitHub / Gitea webhook → Discord / Telegram dispatcher on Cloudflare Workers (Nuxt 4)",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "deploy": "wrangler deploy",
    "cf:dev": "nuxt build && wrangler dev",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test --parallel=1",
    "db:migrate": "wrangler d1 migrations apply webhooker --local",
    "db:migrate:prod": "wrangler d1 migrations apply webhooker --remote",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@elysola/ui": "^0.5.0",
    "h3": "^1.15.3",
    "markdown-it": "^15.0.0",
    "nuxt": "^4.1.0",
    "octokit": "^5.0.5",
    "valibot": "^1.4.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^10.9.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitepress": "^1.6.4",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "4"
  }
}
